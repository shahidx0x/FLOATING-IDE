{
	"name": "FLIDE Midnight",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"foreground": "#C9CDD6",
		"descriptionForeground": "#9AA1AE",
		"focusBorder": "#7AA2FF80",
		"widget.shadow": "#00000080",
		"textLink.foreground": "#7AA2FF",
		"textLink.activeForeground": "#A9C2FF",

		"editor.background": "#14161B",
		"editor.foreground": "#E6E8EE",
		"editorGutter.background": "#14161B",
		"editorLineNumber.foreground": "#5C6370",
		"editorLineNumber.activeForeground": "#C9CDD6",
		"editor.lineHighlightBackground": "#7AA2FF12",
		"editor.lineHighlightBorder": "#00000000",
		"editor.selectionBackground": "#7AA2FF40",
		"editor.inactiveSelectionBackground": "#7AA2FF20",
		"editor.wordHighlightBackground": "#7AA2FF20",
		"editor.findMatchBackground": "#FFB45455",
		"editor.findMatchHighlightBackground": "#FFB45425",
		"editorCursor.foreground": "#7AA2FF",
		"editorWhitespace.foreground": "#2A2F3A",
		"editorIndentGuide.background1": "#1F232C",
		"editorBracketMatch.background": "#7AA2FF25",
		"editorBracketMatch.border": "#00000000",
		"editorError.foreground": "#FF6B6B",
		"editorWarning.foreground": "#FFB454",
		"editorGroup.border": "#FFFFFF10",
		"editorGroupHeader.tabsBackground": "#101216",
		"editorGroupHeader.tabsBorder": "#FFFFFF10",
		"editorGroupHeader.noTabsBackground": "#101216",
		"tab.activeBackground": "#14161B",
		"tab.activeForeground": "#E6E8EE",
		"tab.activeBorder": "#14161B",
		"tab.activeBorderTop": "#7AA2FF",
		"tab.inactiveBackground": "#101216",
		"tab.inactiveForeground": "#7C8493",
		"tab.hoverBackground": "#1B1E25",
		"tab.hoverForeground": "#C9CDD6",
		"tab.border": "#FFFFFF0A",
		"tab.unfocusedActiveBackground": "#14161B",
		"tab.unfocusedActiveForeground": "#C9CDD6",
		"tab.unfocusedActiveBorderTop": "#7AA2FF66",
		"tab.unfocusedInactiveForeground": "#5C6370",
		"tab.unfocusedHoverBackground": "#1B1E25",
		"tab.activeModifiedBorder": "#FFB454",
		"tab.inactiveModifiedBorder": "#FFB45466",
		"tab.dragAndDropBorder": "#7AA2FF",
		"tab.lastPinnedBorder": "#FFFFFF14",
		"editorWidget.background": "#1B1E25",
		"editorWidget.border": "#FFFFFF14",
		"editorSuggestWidget.background": "#1B1E25",
		"editorSuggestWidget.border": "#FFFFFF14",
		"editorSuggestWidget.selectedBackground": "#2A2F3A",
		"editorSuggestWidget.highlightForeground": "#7AA2FF",
		"editorHoverWidget.background": "#1B1E25",
		"editorHoverWidget.border": "#FFFFFF14",
		"editorOverviewRuler.border": "#00000000",

		"titleBar.activeBackground": "#101216",
		"titleBar.inactiveBackground": "#101216",
		"titleBar.activeForeground": "#E6E8EE",
		"titleBar.inactiveForeground": "#9AA1AE",
		"titleBar.border": "#FFFFFF12",

		"panel.background": "#0F1115",
		"panel.border": "#FFFFFF14",
		"panelTitle.activeForeground": "#E6E8EE",
		"panelTitle.inactiveForeground": "#7C8493",
		"panelTitle.activeBorder": "#7AA2FF",
		"terminal.background": "#0F1115",
		"terminal.foreground": "#C9CDD6",
		"terminalCursor.foreground": "#7AA2FF",
		"terminal.selectionBackground": "#7AA2FF40",
		"terminal.ansiBlue": "#7AA2FF",
		"terminal.ansiCyan": "#5FD3E0",
		"terminal.ansiGreen": "#9FD8A4",
		"terminal.ansiMagenta": "#C39BFF",
		"terminal.ansiYellow": "#FFB454",
		"terminal.ansiRed": "#FF6B6B",
		"terminal.ansiBrightBlack": "#7C8493",

		"sideBar.background": "#111318",
		"sideBar.border": "#FFFFFF14",
		"sideBarSectionHeader.background": "#111318",

		"input.background": "#1B1E25",
		"input.border": "#FFFFFF10",
		"input.foreground": "#E6E8EE",
		"input.placeholderForeground": "#7C8493",
		"inputOption.activeBorder": "#7AA2FF",
		"dropdown.background": "#1B1E25",
		"dropdown.border": "#FFFFFF14",
		"checkbox.background": "#1B1E25",
		"checkbox.border": "#FFFFFF20",

		"button.background": "#7AA2FF",
		"button.foreground": "#0E1014",
		"button.hoverBackground": "#A9C2FF",
		"button.secondaryBackground": "#2A2F3A",
		"button.secondaryForeground": "#E6E8EE",
		"badge.background": "#7AA2FF",
		"badge.foreground": "#0E1014",
		"progressBar.background": "#7AA2FF",

		"quickInput.background": "#14161B",
		"quickInputList.focusBackground": "#1F232C",
		"pickerGroup.foreground": "#7AA2FF",
		"list.activeSelectionBackground": "#1F232C",
		"list.activeSelectionForeground": "#E6E8EE",
		"list.inactiveSelectionBackground": "#1B1E25",
		"list.hoverBackground": "#1B1E25",
		"list.focusOutline": "#7AA2FF80",
		"list.highlightForeground": "#7AA2FF",

		"menu.background": "#1B1E25",
		"menu.foreground": "#C9CDD6",
		"menu.selectionBackground": "#2A2F3A",
		"menu.border": "#FFFFFF14",
		"notifications.background": "#1B1E25",
		"notifications.border": "#FFFFFF14",
		"settings.headerForeground": "#E6E8EE",
		"settings.modifiedItemIndicator": "#7AA2FF",

		"scrollbarSlider.background": "#FFFFFF14",
		"scrollbarSlider.hoverBackground": "#FFFFFF24",
		"scrollbarSlider.activeBackground": "#FFFFFF30",
		"scrollbar.shadow": "#00000000"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7C8493", "fontStyle": "italic" } },
		{ "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.logical.python", "keyword.operator.expression", "constant.language"], "settings": { "foreground": "#C39BFF" } },
		{ "scope": ["string", "string.quoted", "punctuation.definition.string", "string.template"], "settings": { "foreground": "#9FD8A4" } },
		{ "scope": ["constant.numeric", "constant.character.escape", "constant.other"], "settings": { "foreground": "#FFB454" } },
		{ "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function", "support.function.builtin"], "settings": { "foreground": "#7AA2FF" } },
		{ "scope": ["support.type", "entity.name.type", "entity.name.class", "support.class", "storage.type.primitive", "support.type.python", "entity.other.inherited-class"], "settings": { "foreground": "#5FD3E0" } },
		{ "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable"], "settings": { "foreground": "#E6E8EE" } },
		{ "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "#C9CDD6" } },
		{ "scope": ["entity.name.tag"], "settings": { "foreground": "#C39BFF" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#5FD3E0" } },
		{ "scope": ["markup.heading"], "settings": { "foreground": "#7AA2FF", "fontStyle": "bold" } },
		{ "scope": ["invalid"], "settings": { "foreground": "#FF6B6B" } }
	]
}
